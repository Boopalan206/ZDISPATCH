projection;
strict ( 2 );
//use draft;
use side effects;

define behavior for ZC_Trip_API alias TripHeader
{
  use create;
  use update;
  use delete;

  use action StartTrip;
  use action Settle;
  use action EmergencyLockdown;
  use action Unlock;
  use action AddNewLocation;

//  use action Activate;
//  use action Resume;
//  use action Edit;
//  use action Discard;
//  use action Prepare;

  use association _Incident { create; }

  field ( readonly ) ReviewReason, PreviousStatus;
}

define behavior for ZC_Incident_API alias TripIncident
{
  use update;
  use delete;

  use action IncidentVerified;

  use association _TripHeader;
  use association _IAttachment { create; }
}

define behavior for ZC_Attach_API alias IncidentAttachment
{
  use update;
  use delete;

  use association _TripIncident;
  use association _Root;
}