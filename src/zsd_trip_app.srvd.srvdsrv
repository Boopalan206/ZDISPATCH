@EndUserText.label: 'Trip Application Service'
define service ZSD_TRIP_APP {
  expose ZC_TripHeader   as TripHeader;
  expose ZC_TripIncident as TripIncidents;
  expose ZC_INC_ATT1     as IncidentAttachments;
  expose zi_driver       as Driver;
  expose ZI_Vehicle      as Vehicle;
  expose ZI_Location     as Location;
  expose ZI_LoadTypeVH   as LoadTypeVH;
  expose ZI_IncCategVH   as IncidentCategoryVH;
}