projection;
strict ( 2 );
use draft;
use side effects;

define behavior for ZC_TripHeader alias TripHeader
use etag
{
  use create;
  use update;
  use delete;

  use action Activate;
  use action Resume;
  use action Edit;
  use action Discard;
  use action Prepare;

  use action StartTrip;
  use action Unlock;
  use action Settle;
//  use action CancelTrip;
  use action AddNewLocation;
  use action EmergencyLockdown;

  use association _Incident { create; with draft; }

}

define behavior for ZC_TripIncident alias TripIncident
{
  use update;
  use delete;

  use association _TripHeader { with draft; }
  use association _IAttachment {create; with draft;}
  use action IncidentVerified;
}

define behavior for ZC_INC_ATT1 alias IncidentAttachment
{
  use update;
  use delete;

  use association _TripIncident { with draft; }
  use association _Root { with draft; }
}